# Rota privada (12-128 caracteres: letras, numeros, _ ou -)
SERVERSAFE_AI_SLUG=
# Chave humana para liberar a interface (minimo 32 caracteres)
# Segredo aleatorio para assinar cookies HttpOnly (minimo 32 caracteres)
SERVERSAFE_SESSION_SECRET=

# Upstash Redis gratuito, usado server-side para dados, locks e rate limit
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AWS Bedrock Mantle, Claude Haiku 4.5, us-east-1
SERVERSAFE_BEDROCK_API_KEY=

# Snapshot Vercel Sandbox criado com `npm run ai:snapshot`
SERVERSAFE_AI_SANDBOX_SNAPSHOT_ID=

# Limites opcionais
OPENHARNESS_MAX_MESSAGE_CHARS=12000
OPENHARNESS_MAX_HISTORY_CHARS=30000
OPENHARNESS_MAX_RESPONSE_CHARS=60000
SERVERSAFE_MAX_CONVERSATION_CHARS=500000
SERVERSAFE_MAX_OWNER_STORAGE_CHARS=800000
SERVERSAFE_MAX_CONVERSATIONS=100
SERVERSAFE_MAX_PROJECTS=50
OPENHARNESS_MAX_STREAM_BUFFER_CHARS=262144
OPENHARNESS_RATE_LIMIT_PER_MINUTE=20
OPENHARNESS_MAX_CONCURRENCY=2
OPENHARNESS_MAX_TURNS=4
OPENHARNESS_TIMEOUT_MS=50000
